{
  "name": "@nginxui/plugin-market-ui",
  "type": "module",
  "version": "0.1.0",
  "description": "The plugin marketplace views of Nginx UI, shared with the developer portal's previews",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nginxui/plugin-market-ui.git"
  },
  "keywords": [
    "nginx-ui",
    "plugin",
    "marketplace",
    "vue"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./msgids.json": "./dist/msgids.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && vite build && vue-tsc -p tsconfig.build.json && cp src/msgids.json dist/msgids.json",
    "dev": "vite build --watch",
    "messages": "node scripts/messages.mjs",
    "test": "vitest run",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix ."
  },
  "peerDependencies": {
    "@antdv-next/icons": ">=1.1",
    "antdv-next": ">=1.5",
    "vue": "^3.5"
  },
  "devDependencies": {
    "@antdv-next/icons": "^1.1.2",
    "@antfu/eslint-config": "^9.5.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.4.6",
    "antdv-next": "^1.6.0",
    "eslint": "^10.12.0",
    "gettext-parser": "^9.1.1",
    "happy-dom": "^20.0.0",
    "typescript": "5.9.3",
    "vite": "^8.3.2",
    "vitest": "^4.1.0",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.12"
  }
}
